@model bool
@* Registration, one step (app/020-access.js takes the press of #reg-next-btn): name, e-mail, the track (it decides the
   role in the emergency room, chosen once; decision log D-57) and the year of study (D-58). No password in this
   phase (ADR 0008). Model: true when the page opens on registration. *@
<div id="auth-pane-register" class="nl-auth-form@(Model ? "" : " hidden")">
<p class="nl-auth-subtitle">أنشئ حسابك وابدأ أول حالة مباشرة. بريدك الجامعي يفتح لك قسم جامعتك.</p>
<div class="nl-auth-field">
<label class="nl-auth-label" for="reg-name">الاسم الكامل</label>
<div class="nl-auth-input-wrap"><span class="nl-auth-input-icon" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"></path></svg></span><input id="reg-name" class="nl-auth-input nl-has-icon" type="text" placeholder="مثال: أحمد الزعبي" autocomplete="name" /></div>
</div>
<div class="nl-auth-field">
<label class="nl-auth-label" for="reg-email">البريد الإلكتروني</label>
<div class="nl-auth-input-wrap"><span class="nl-auth-input-icon" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m4 7 8 6 8-6"></path></svg></span><input id="reg-email" class="nl-auth-input nl-has-icon" type="email" dir="ltr" inputmode="email" placeholder="name@university.edu.jo" autocomplete="email" /></div>
<small class="nl-auth-hint">في هذه النسخة يكفي البريد الإلكتروني. الدخول بكلمة مرور أو بحساب الجامعة يأتي مع النسخة المرتبطة بالخادم.</small>
</div>
<div class="nl-auth-field">
<span class="nl-auth-label" id="nb8-rolehead">مسارك <small>(يحدد دورك في غرفة الطوارئ)</small></span>
<div class="nl-auth-roles" id="reg-rolecards" role="group" aria-labelledby="nb8-rolehead">
<button type="button" data-rc="nursing" aria-pressed="false"><span class="nl-auth-role-icon" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z"></path><path d="M12 9v5M9.5 11.5h5"></path></svg></span><strong>طالب تمريض</strong><small>تقييم المريض والعناية السريرية</small></button>
<button type="button" data-rc="medicine" aria-pressed="false"><span class="nl-auth-role-icon" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24"><path d="M6 3v6a5 5 0 0 0 10 0V3"></path><path d="M11 14v2a5 5 0 0 0 10 0v-2"></path><circle cx="21" cy="12" r="2"></circle></svg></span><strong>طالب طب</strong><small>التشخيص التفريقي واتخاذ القرار</small></button>
</div>
</div>
<div class="nl-auth-field" id="reg-year-wrap">
<label class="nl-auth-label" for="reg-year">السنة الدراسية</label>
<select id="reg-year" class="nl-auth-input">
<option value="1">السنة الأولى</option>
<option value="2">السنة الثانية</option>
<option value="3">السنة الثالثة</option>
<option value="4" selected>السنة الرابعة</option>
<option value="5">السنة الخامسة</option>
<option value="6">السنة السادسة</option>
</select>
</div>
<div id="reg-error-msg" role="alert" class="nl-auth-alert hidden"></div>
<button id="reg-next-btn" type="button" class="nl-auth-submit">إنشاء الحساب</button>
@await Html.PartialAsync("~/Views/Account/_ExternalSignIn.cshtml", "register")
<p class="nl-auth-switch">لديك حساب بالفعل؟ <button id="auth-tab-login" type="button">تسجيل الدخول</button></p>
</div>