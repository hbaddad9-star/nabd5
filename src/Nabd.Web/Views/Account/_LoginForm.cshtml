@model bool
@* The sign-in form: the e-mail decides who enters (app/020-access.js takes its submit). There is no password in this
   phase (ADR 0008); an e-mail without an account goes to registration (decision log D-59). Model: true when the
   page opens on registration (this form then starts hidden). *@
<form id="auth-pane-login" class="nl-auth-form@(Model ? " hidden" : "")">
<p class="nl-auth-subtitle">سجّل الدخول ببريدك لمتابعة تدريبك ومراجعة تقارير أدائك في نبض.</p>
<div class="nl-auth-field">
<label class="nl-auth-label" for="login-email">البريد الإلكتروني</label>
<div class="nl-auth-input-wrap"><span class="nl-auth-input-icon" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m4 7 8 6 8-6"></path></svg></span><input id="login-email" class="nl-auth-input nl-has-icon" type="email" dir="ltr" inputmode="email" placeholder="name@university.edu.jo" autocomplete="username" required /></div>
<small class="nl-auth-hint">في هذه النسخة يكفي البريد الإلكتروني. الدخول بكلمة مرور أو بحساب الجامعة يأتي مع النسخة المرتبطة بالخادم.</small>
</div>
<div id="login-error-msg" role="alert" class="nl-auth-alert hidden"></div>
<button id="submit-login-btn" type="submit" class="nl-auth-submit">تسجيل الدخول</button>
@await Html.PartialAsync("~/Views/Account/_ExternalSignIn.cshtml", "login")
<p class="nl-auth-switch">ليس لديك حساب؟ <button id="auth-tab-register" type="button">إنشاء حساب جديد</button></p>
@await Html.PartialAsync("~/Views/Account/_DemoAccounts.cshtml")
</form>