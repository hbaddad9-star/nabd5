    <!-- The operating-room section (#view-or): the 3D operating room (wwwroot/or3d, the simulator, shown in its own frame
         with its own controls hidden: ?embed=1) and, on its left, the team's chat. The camera views, the monitor and the
         anatomy are the platform's own buttons (data-or-act), which press the simulator's. app/095-operating-room.js loads
         the frame when the page is first opened and keeps the buttons in step; app/096-or-chat.js runs the session. -->
    <section id="view-or" class="hidden or-view" aria-labelledby="or-title" data-no-terms>
      <div class="or-wrap">
        <div class="or-bar">
          <button id="or-back-btn" class="or-back focus-ring" type="button"><span aria-hidden="true">→</span> الرئيسية</button>
          <div class="or-head">
            <span class="or-eyebrow">قسم العمليات <em class="or-pill">نسخة تجريبية</em></span>
            <h1 id="or-title">غرفة العمليات ثلاثية الأبعاد</h1>
          </div>
          <dl class="or-facts" aria-label="الحالة">
            <div><dt>المريض</dt><dd>سامر خالد</dd></div>
            <div><dt>الإجراء</dt><dd>استئصال الزائدة الدودية</dd></div>
            <div><dt>الجهة</dt><dd>اليمنى</dd></div>
          </dl>
        </div>
        <div class="or-room">
          <div id="or3d-stage" class="or-stage" role="region" aria-label="غرفة العمليات ثلاثية الأبعاد">
            <iframe id="or3d-frame" class="or-frame" title="غرفة العمليات ثلاثية الأبعاد" data-src="or3d/index.html?embed=1" allow="fullscreen"></iframe>
            <div class="or-side" role="group" aria-label="أدوات العرض">
              <button type="button" class="or-tool is-icon focus-ring" data-or-act="open-vitals"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h5l2.4-5 3.6 10 2.6-5H22"/></svg>العلامات الحيوية</button>
              <button type="button" class="or-tool is-icon focus-ring" data-or-act="anatomy-toggle" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c-3 0-5 2-5 5 0 2 1 3 1 5s-1 3-1 5c0 2 2 3 5 3s5-1 5-3c0-2-1-3-1-5s1-3 1-5c0-3-2-5-5-5Z"/><path d="M9.5 9c1.5 1 3.5 1 5 0M9 14c2 1 4 1 6 0"/></svg>التشريح الداخلي</button>
              <button type="button" class="or-tool is-icon focus-ring" data-or-full><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v5m11-5h5v5m0 6v5h-5m-6 0H4v-5"/></svg>ملء الشاشة</button>
            </div>
            <div class="or-tools" role="group" aria-label="زوايا الكاميرا">
              <div class="or-tools-row">
                <div class="or-group" role="group" aria-label="الغرفة">
                  <span class="or-group-label">الغرفة</span>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-room" aria-pressed="true">المدخل</button>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-surgeon" aria-pressed="false">موقع الجرّاح</button>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-anesthesia" aria-pressed="false">التخدير</button>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-instruments" aria-pressed="false">الأدوات</button>
                </div>
                <div class="or-group" role="group" aria-label="المريض">
                  <span class="or-group-label">المريض</span>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-overview" aria-pressed="false">الجسم كاملاً</button>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-face" aria-pressed="false">الوجه</button>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-torso" aria-pressed="false">الصدر</button>
                  <button type="button" class="or-tool focus-ring" data-or-act="camera-abdomen" aria-pressed="false">البطن</button>
                </div>
              </div>
            </div>
            <div id="or3d-loading" class="or-loading" role="status">
@await Html.PartialAsync("~/Views/Home/OperatingRoom/_RoomSketch.cshtml")
              <b>جارٍ تجهيز غرفة العمليات…</b>
              <span>يستغرق تحميل المريض والفريق والأجهزة لحظات.</span>
            </div>
          </div>
          <aside id="or-chat" class="or-chat" aria-labelledby="or-chat-title">
            <header class="or-chat-head">
              <div class="or-chat-who">
                <b id="or-chat-title">فريق العملية</b>
                <span>المشرف · المريض سامر خالد</span>
              </div>
              <span id="or-chat-step" class="or-chat-step">الخطوة 1 من 6</span>
              <div class="or-progress" aria-hidden="true"><i id="or-progress-bar"></i></div>
            </header>
            <ol id="or-chat-log" class="or-chat-log" aria-live="polite"></ol>
            <div class="or-chat-reply">
              <span class="or-reply-label">الرد بفعل</span>
              <div id="or-chat-actions" class="or-chat-actions" role="group" aria-label="الرد بفعل"></div>
              <form id="or-chat-form" class="or-chat-form" autocomplete="off">
                <input id="or-chat-input" type="text" placeholder="أو اكتب رسالتك إلى المشرف أو المريض…" aria-label="رسالتك إلى المشرف أو المريض">
                <button type="submit" class="focus-ring" aria-label="إرسال"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5m6-7-7 7 7 7"/></svg></button>
              </form>
            </div>
          </aside>
        </div>
        <p class="or-credits">حالة تدريبية لم يراجعها طبيب بعد. غرفة العمليات ثلاثية الأبعاد من مشروع محاكي نبض. الأعضاء الداخلية: <a href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/lic.html" target="_blank" rel="noopener noreferrer">BodyParts3D</a> © The Database Center for Life Science، <span dir="ltr">CC BY 4.0</span>، مع تعديل. مجسّم المريض <span dir="ltr">CC0</span>. المكتبات: <span dir="ltr">Three.js (MIT)</span> و<span dir="ltr">Rapier (Apache 2.0)</span>؛ نصوص التراخيص كاملة مع ملفات المحاكي في المشروع.</p>
      </div>
    </section>
