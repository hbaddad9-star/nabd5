# Text files are stored with line feeds in the repository; the working copy follows the platform.
* text=auto
*.sln text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary

# The case data files are served to the browser as they are: no line-ending conversion.
src/Nabd.Infrastructure/CaseData/Files/** -text
